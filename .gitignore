# ============================================================
# Urban Traffic Accident Risk Assessment & Prediction
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Jupyter
# ------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------
# Data files
# Large/raw/generated data should NOT be committed
# ------------------------------------------------------------
Code/backend/data/raw/*
Code/backend/data/interim/*
Code/backend/data/processed/*
Code/backend/data/external/*

# Keep required data directory structure
!Code/backend/data/raw/road_accident/.gitkeep
!Code/backend/data/raw/traffic_accidents/.gitkeep

!Code/backend/data/interim/road_accident/.gitkeep
!Code/backend/data/interim/traffic_accidents/.gitkeep
!Code/backend/data/interim/integrated/.gitkeep

!Code/backend/data/processed/structured/.gitkeep
!Code/backend/data/processed/text/.gitkeep
!Code/backend/data/processed/final/.gitkeep

!Code/backend/data/external/knowledge_base/.gitkeep
!Code/backend/data/external/knowledge_base/*.md

# ------------------------------------------------------------
# Model artifacts
# Generated/trained model binaries should NOT be committed
# ------------------------------------------------------------
Code/backend/models/artifacts/*
Code/backend/models/metadata/*

!Code/backend/models/artifacts/.gitkeep
!Code/backend/models/metadata/.gitkeep

# ------------------------------------------------------------
# Generated reports
# ------------------------------------------------------------
Code/backend/reports/figures/*
Code/backend/reports/metrics/*
Code/backend/reports/final/*

!Code/backend/reports/figures/.gitkeep
!Code/backend/reports/metrics/.gitkeep
!Code/backend/reports/final/.gitkeep

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Microsoft Office temporary / lock files
~$*
*.tmp

# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

# ------------------------------------------------------------
# Build / Distribution
# ------------------------------------------------------------
build/
dist/
*.egg-info/

# ------------------------------------------------------------
# Testing / Coverage
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
*.temp
*.swp
*.swo
*.bak
*.orig

# ------------------------------------------------------------
# Frontend - Node
# ------------------------------------------------------------
Code/frontend/node_modules/
Code/frontend/dist/
Code/frontend/.vite/
Code/frontend/.cache/

# Frontend environment files
Code/frontend/.env
Code/frontend/.env.*
!Code/frontend/.env.example

# ------------------------------------------------------------
# TypeScript
# ------------------------------------------------------------
*.tsbuildinfo